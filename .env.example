# Copy the keys you need into .env.local. Never commit .env.local.

# ---------------------------------------------------------------------------
# Blog (MongoDB + Vercel Blob + admin auth)
# ---------------------------------------------------------------------------

# Connection string for the posts database. Any Mongo works: Atlas, a local
# mongod, or a throwaway cluster. Swapping this for the client's Atlas URL later
# is the whole migration, plus a mongodump/mongorestore of the `posts`
# collection.
MONGODB_URI=

# Database name inside that cluster. Defaults to "slic" when unset.
MONGODB_DB=

# Both values come from:  node scripts/hash-password.mjs "your password"
# The plaintext password is never stored anywhere - only this scrypt hash.
ADMIN_PASSWORD_HASH=
# Signs the admin session cookie. Needs 32+ characters. Changing it signs
# everyone out immediately, which is the fastest way to revoke access.
ADMIN_SESSION_SECRET=

# Image uploads. Created for you on Vercel when the project has a Blob store;
# for local development run `vercel env pull .env.local` to fetch it.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Contact / careers form
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# Where new applications are delivered.
JOIN_NOTIFY_EMAIL=

# Optional override for the sender. The code defaults to
# "SLIC Careers <careers@slic.agency>", which requires slic.agency to be
# verified in Resend with SPF, DKIM and DMARC. Until that is done Resend answers
# 403 and the route retries on Resend's shared sandbox sender so no application
# is lost - watch the logs for the warning, it should stop once the domain is up.
JOIN_FROM_EMAIL=

# Optional override for reply-to. Defaults to hello@slic.agency, the shared
# inbox the site publishes everywhere else. Set it to team@slic.agency once that
# mailbox exists.
JOIN_REPLY_TO=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://slic.agency
NEXT_PUBLIC_CALENDLY_URL=

# ---------------------------------------------------------------------------
# Analytics (Umami Cloud)
# ---------------------------------------------------------------------------

# All optional. The website ID is public and already defaulted in
# lib/analytics.ts, so production works with none of these set.

# Override the website ID, e.g. to point a fork at a different Umami project.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Override the tracker URL. Set to a self-hosted instance, or to a first-party
# path like /u/script.js if you add the proxy rewrites described in
# components/umami-analytics.tsx.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Force the tag on outside production. The only reason to set this is to verify
# the integration from a preview deploy; leave it unset otherwise, or preview
# and local traffic lands in the client's dashboard. Note you must also point
# NEXT_PUBLIC_SITE_URL at the same host, since the tracker refuses to send from
# a hostname other than the canonical one.
NEXT_PUBLIC_UMAMI_ENABLED=
